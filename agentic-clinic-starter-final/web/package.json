  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "1.7.6",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "11.0.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "5.9.3"
  }
}
